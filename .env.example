# PowerShell examples:
#   $env:FIRESIGHT_RTSP_URL = 'rtsp://camera-host:554/stream'
#   $env:FIRESIGHT_SOURCE = 'C:\path\to\clip.mp4'  # or a camera index such as 0
# Keep credentials in the process environment or an untracked local secret store.

FIRESIGHT_MODEL_PATH=models/best.pt
FIRESIGHT_CONFIDENCE_THRESHOLD=0.4
FIRESIGHT_CONFIRMATION_FRAMES=3
FIRESIGHT_RTSP_URL=
FIRESIGHT_SOURCE=
FIRESIGHT_EVIDENCE_DIR=runs/firesight/evidence
FIRESIGHT_EVENT_DB=runs/firesight/events.sqlite3
FIRESIGHT_DETECTION_LOG=runs/firesight/detections.jsonl
FIRESIGHT_OUTPUT_VIDEO_DIR=runs/firesight/processed_video
FIRESIGHT_INTERNAL_ALERTS=true
FIRESIGHT_EXTERNAL_ALERTS=false
